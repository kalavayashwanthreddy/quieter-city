# Local development (JSON-file storage, no Firebase Admin credentials needed)
NODE_ENV=development
STORAGE_BACKEND=local
FIREBASE_PROJECT_ID=vibra-map
AUTH_REQUIRED=false
AUTH_SECRET=replace-with-a-long-random-secret
ADMIN_TOKEN=replace-with-a-long-random-admin-token
CLIENT_ORIGIN=http://localhost:5173
VITE_API_AUTH=false

# Render production (one web service: Vite frontend + Express API + Firestore)
# Set these in Render Environment Variables; never commit real values.
# NODE_ENV=production
# STORAGE_BACKEND=firestore
# SIM_ENABLED=false
# FIREBASE_PROJECT_ID=vibra-map
# AUTH_REQUIRED=true
# AUTH_SECRET=replace-with-a-long-random-secret
# ADMIN_TOKEN=replace-with-a-long-random-admin-token
# CLIENT_ORIGIN=https://your-service.onrender.com
# FIREBASE_SERVICE_ACCOUNT_BASE64=<base64-encoded Firebase service-account JSON>
# VITE_API_AUTH=true

# Alternative for a trusted secret manager only; do not commit the JSON:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
