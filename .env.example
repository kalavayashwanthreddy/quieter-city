# Local Firestore mode. Cloud Run uses its attached service account.
NODE_ENV=development
STORAGE_BACKEND=local
FIREBASE_PROJECT_ID=vibra-map
AUTH_REQUIRED=false
AUTH_SECRET=replace-with-a-long-random-secret
ADMIN_TOKEN=replace-with-a-long-random-admin-token
CLIENT_ORIGIN=http://localhost:5173

# For local Firestore mode, install firebase-admin and point this at a
# service-account JSON file kept outside Git. Do not use this in Cloud Run.
# GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json

# Frontend build setting for Cloud Run + Firestore API mode.
# VITE_API_AUTH=false
# VITE_ADMIN_TOKEN=replace-with-a-long-random-admin-token
